# Reconstructed from the pinned lockfile and independently verified inventory.
# These trees contain a >100 MB Node binary and must never be committed to Git.
/VendorRuntime/node-v*/
/VendorRuntime/node_modules/
# Interrupted bootstrap/materialization state must never enter the first index.
/VendorRuntime/.node-bootstrap.*/
/VendorRuntime/.fulmar-materialize-*/
/VendorRuntime/.npm-cache/
/VendorRuntime/**/.*.fulmar-patch
node_modules/
npm-debug.log*
yarn-error.log*

